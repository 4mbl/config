{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base",
  "compilerOptions": {
    /* Base Options */
    "rootDir": "${configDir}/src",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["${configDir}/src/*"]
    },
    "types": [],

    /* Output */
    //* "target" is omitted here intentionally, typescript
    //* defaults to current year's ecmascript standard

    "outDir": "${configDir}/dist",
    "sourceMap": true,
    "declarationMap": true,
    "declaration": true,
    "incremental": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.tsbuildinfo",
    "verbatimModuleSyntax": true,

    /* Linting */
    "strict": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    // exactOptionalPropertyTypes causes too much noise to enable.
    // Disabled explicitly as a reminder to keep it off.
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": ["${configDir}/node_modules"]
}
